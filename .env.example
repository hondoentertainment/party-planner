# Copy this file to `.env.local` and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional aliases for Vercel routing middleware (defaults to VITE_SUPABASE_* if unset).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Optional — only for `npm run db:types` (Reference ID in Project Settings → General)
# SUPABASE_PROJECT_ID=

# Optional — Sentry (browser DSN; leave empty to disable)
# VITE_SENTRY_DSN=
# Optional — Sentry environment name (defaults: production / development from build mode)
# VITE_SENTRY_ENVIRONMENT=staging

# Optional — RFC 9116 Contact for production `/.well-known/security.txt` (built into dist/; e.g. mailto:security@yourdomain.com)
# VITE_SECURITY_CONTACT=mailto:security@yourdomain.com

# Optional — Canonical site origin for public share meta (Open Graph URL, canonical links).
# No trailing slash. Example: https://your-app.vercel.app
# Used by the SPA and by Vercel routing middleware for `/s/*` link previews.
# VITE_PUBLIC_SITE_URL=

# Optional — Plausible Analytics (no cookies; set domain to your production hostname, no protocol).
# VITE_PLAUSIBLE_DOMAIN=yourdomain.com
# Self-hosted: set script URL here and add that host to Content-Security-Policy-Report-Only in vercel.json (script-src / connect-src).
# VITE_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Optional — Web push (VAPID public key only; generate with `npx web-push generate-vapid-keys`)
# Must match the public key configured on the notify-assignment Edge Function.
# VITE_VAPID_PUBLIC_KEY=

# Optional — Playwright (npm run test:e2e / verify). Same user must exist in Supabase Auth.
# Merged from .env.local by playwright.config.ts; CI uses GitHub Actions secrets only.
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_DISPLAY_NAME=E2E Test User

# Optional — Playwright preview port (default 4291) and reuse. See playwright.config.ts.
# PW_PREVIEW_PORT=4291
# PW_REUSE_DEV_SERVER=1
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:4291

# Local parity check (reads .env.local if present): npm run ops:check-env  (add --strict to fail CI-style)
#
# Optional — post-deploy HTTP smoke (also: GitHub Smoke workflow).
# origin="https://your-app.vercel.app" ; npm run ops:smoke -- $origin
# Or set VITE_PUBLIC_SITE_URL / SMOKE_URL in `.env.local` then: npm run ops:smoke
# Or: SMOKE_PATHS="/ /healthz /privacy /terms" npm run ops:smoke -- https://...
# APP_URL must match production on Supabase Edge secrets (not used by Vite).

# Release label for Sentry (optional — Vercel/GitHub usually inject SHA without this)
# VITE_APP_RELEASE=party-planner@dev

# Optional — Supabase Edge Function secrets (`supabase secrets set`, not Vite / .env.local):
# BUG_REPORT_NOTIFY_EMAIL=you@example.com
#   Inbox for notify-bug-report (new bug_reports rows). If unset, uses the address parsed from FROM_EMAIL.
