{
  "name": "party-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "cross-env ANALYZE=1 vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "node scripts/run-playwright-local.mjs",
    "test:e2e:external": "playwright test",
    "test:e2e:visual": "node scripts/run-playwright-local.mjs --project=visual-qa",
    "verify": "npm run lint && npm run build && npm run test:e2e",
    "preflight": "npm run lint && npm run build && node scripts/check-deploy-env.mjs",
    "ci": "npm run verify",
    "db:push": "npx supabase db push",
    "db:types": "node scripts/gen-db-types.mjs",
    "sql:fill-reminder-cron": "node scripts/fill-reminder-cron.mjs",
    "ops:check-resend": "node scripts/check-resend-secret.mjs",
    "ops:check-env": "node scripts/check-deploy-env.mjs",
    "ops:smoke": "node scripts/smoke-http.mjs",
    "ops:rsvp-load": "node scripts/rsvp-submit-load.mjs",
    "ops:post-0025": "node scripts/ops-post-0025.mjs",
    "ops:secrets-audit": "node scripts/secrets-audit.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "functions:deploy": "npx supabase functions deploy notify-assignment",
    "functions:deploy:share": "npx supabase functions deploy notify-share",
    "functions:deploy:invite": "npx supabase functions deploy notify-invite",
    "functions:deploy:wrap-up": "npx supabase functions deploy notify-wrap-up",
    "functions:deploy:reminders": "npx supabase functions deploy notify-event-reminder",
    "functions:deploy:unsubscribe": "npx supabase functions deploy notify-unsubscribe --no-verify-jwt",
    "functions:deploy:rsvp-recovery": "npx supabase functions deploy notify-rsvp-recovery --no-verify-jwt",
    "functions:deploy:bug-report": "npx supabase functions deploy notify-bug-report",
    "functions:serve": "npx supabase functions serve notify-assignment --no-verify-jwt"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.104.0",
    "@vercel/functions": "^3.5.0",
    "@vercel/og": "^0.11.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.5.0",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.9",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "react-dom": "$react"
  }
}
